// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "format_on_save": "on",
  "hard_tabs": false,
  "auto_indent": "preserve_indent",
  "document_folding_ranges": "off",
  "diff_view_style": "split",
  "ui_font_family": "IBM Plex Mono",
  "agent": {
    "dock": "left",
    "default_model": {
      "provider": "ZHIPU",
      "model": "glm-5.1",
      "enable_thinking": false,
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "language_models": {
    "openai_compatible": {
      "ZHIPU": {
        "api_url": "https://open.bigmodel.cn/api/coding/paas/v4",
        "available_models": [
          {
            "name": "glm-5.2",
            "max_tokens": 200000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 200000,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": true,
              "chat_completions": true,
              "interleaved_reasoning": false,
            },
          },
        ],
      },
    },
  },
  "agent_servers": {
    "cursor": {
      "default_config_options": {
        "model": "grok-4.7",
      },
      "type": "registry",
    },
    "opencode": {
      "default_config_options": {
        "effort": "high",
        "mode": "build",
        "model": "zhipuai-coding-plan/glm-5.3-flash",
      },
      "favorite_config_option_values": {
        "model": [
          "zhipuai-coding-plan/glm-4.7",
          "zhipuai-coding-plan/glm-5.1",
          "zhipuai-coding-plan/glm-4.5-air",
          "zhipuai-coding-plan/glm-5v-turbo",
          "zhipuai-coding-plan/glm-4.6v",
          "zhipuai-coding-plan/glm-5.2",
        ],
      },
      "type": "registry",
    },
  },
  "edit_predictions": {
    "zed": {
      "prediction_debounce": 500,
    },
    "provider": "open_ai_compatible_api",
    "mode": "eager",
    "open_ai_compatible_api": {
      "api_url": "https://open.bigmodel.cn/api/coding/paas/v4",
      "max_output_tokens": 256,
      "prompt_format": "glm",
      "model": "glm-5.3",
    },
  },

  "context_servers": {
    "mcp-server-context7": {
      "enabled": true,
      "remote": false,
      "settings": {
        "context7_api_key": "",
      },
    },
    "chrome-devtools-mcp-zed": {
      "enabled": true,
      "remote": false,
      "settings": {},
    },
    "neon": {
      "url": "https://mcp.neon.tech/mcp",
    },
    "cloudflare": {
      "url": "https://mcp.cloudflare.com/mcp",
    },
    "cloudflare-bindings": {
      "url": "https://bindings.mcp.cloudflare.com/mcp",
    },
    "cloudflare-docs": {
      "url": "https://docs.mcp.cloudflare.com/mcp",
    },
  },

  // ---------------- 样式/行为 --------------------
  "vim_mode": true,
  "vim": {
    "use_system_clipboard": "on_yank",
    "toggle_relative_line_numbers": true,
    "use_smartcase_find": true,
  },
  // 当按下 `g` 之后 200ms, 会弹出一个可用快捷键列表
  "which_key": {
    "enabled": true,
    "delay_ms": 400,
  },
  "buffer_font_family": "MonoLisa Nerd Font Mono",
  "buffer_line_height": "comfortable",
  "buffer_font_size": 14.0,
  "outline_panel": {
    "indent_guides": {
      "show": "always",
    },
    "indent_size": 20.0,
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "terminal": {
    "flexible": true,
    "scrollbar": {
      "show": "auto",
    },
    "toolbar": {
      "breadcrumbs": true,
    },
    "option_as_meta": false,
  },
  "git": {
    "git_gutter": "hide",
  },
  "git_panel": {
    "tree_view": false,
    "dock": "right",
    "show_count_badge": true,
    "file_icons": true,
    "status_style": "label_color",
    "default_width": 400.0,
  },
  "theme": "Polycarbonate Gruvbox Dark",
  "title_bar": {
    "show_user_menu": false,
    // "show_menus": true,
    "show_branch_status_icon": true,
  },
  "status_bar": {
    "show_active_file": true,
  },
  "toolbar": {
    "quick_actions": false,
    "breadcrumbs": false,
  },
  "tab_bar": {
    // "show_nav_history_buttons": false,
  },
  "project_panel": {
    "dock": "right",
    "default_width": 400,
    "hide_root": true,
    "auto_fold_dirs": false,
    "starts_open": false,
    "git_status": false,
    "sticky_scroll": false,
    "hide_gitignore": true,
    "scrollbar": {
      "show": "never",
    },
    "indent_guides": {
      "show": "always",
    },
  },
  "scrollbar": {
    "show": "never",
  },
  "gutter": {
    "min_line_number_digits": 0,
    "folds": false,
    "runnables": false,
    "line_numbers": false,
  },
  "indent_guides": {
    "background_coloring": "disabled",
    "active_line_width": 2,
    "line_width": 1,
    "coloring": "indent_aware",
    "enabled": true,
  },
  "drag_and_drop_selection": {
    "enabled": false,
  },
  "current_line_highlight": "none",
  "tab_size": 2,
  "auto_indent_on_paste": true,
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "tabs": {
    "git_status": true,
    "file_icons": false,
  },
  "vertical_scroll_margin": 1,
  "horizontal_scroll_margin": 1,
  "close_on_file_delete": true,
  "file_scan_exclusions": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.git/**",
    "**/.next/**",
  ],

  // Rust 配置
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy",
        },
      },
    },
  },
}
