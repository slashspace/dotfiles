---
import CopyButton from "./CopyButton.astro";
import TerminalCard from "./TerminalCard.astro";
import ThemeDock from "./ThemeDock.astro";
import { githubUrl, installCommand } from "../data/site";
---

<section id="top" class="site-container section-shell pt-10 sm:pt-16">
  <div class="grid items-center gap-10 lg:grid-cols-[1.02fr_0.98fr]">
    <div>
      <p class="font-mono text-sm font-semibold text-cozy-pink" aria-hidden="true">
        ₊✩‧₊˚ macOS dev setup ˚₊✩‧₊
      </p>
      <h1 class="mt-5 max-w-4xl text-5xl font-black leading-[0.95] tracking-[-0.06em] text-cozy-strong sm:text-6xl lg:text-7xl">
        A cozy terminal stack, engineered cleanly
      </h1>
      <p class="mt-6 max-w-2xl text-base leading-8 text-cozy-muted sm:text-lg">
        Stow-managed configs, semantic palettes, and a focused CLI that keep Ghostty,
        Neovim, tmux, SketchyBar, and your macOS workflow in sync.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <CopyButton
          text={installCommand}
          label="Copy install command"
          class="border border-cozy-yellow/70 bg-cozy-yellow text-[#11111b] shadow-[0_18px_60px_rgba(249,226,175,0.24)] hover:scale-[1.02] hover:bg-cozy-strong hover:text-[#11111b]"
        />
        <a
          href={githubUrl}
          class="pill-button border border-white/10 bg-white/5 text-cozy-text hover:bg-white/10 hover:text-cozy-strong"
        >
          View on GitHub
        </a>
      </div>
    </div>

    <div class="relative">
      <div class="absolute -inset-8 -z-10 rounded-full bg-cozy-mauve/20 blur-3xl" aria-hidden="true"></div>
      <TerminalCard title="dotfiles" label="Dotfiles bootstrap terminal preview">
        <div><span class="terminal-accent">~/dotfiles ❯</span> dotfiles bootstrap</div>
        <div class="terminal-muted mt-3 grid gap-1">
          <span>✓ Homebrew bundle checked</span>
          <span>✓ GNU Stow links applied</span>
          <span>✓ Catppuccin palette rendered</span>
          <span class="terminal-success">✓ Ghostty · tmux · Neovim · SketchyBar updated</span>
        </div>
        <div class="terminal-panel mt-6 p-4 text-xs">
          <div class="terminal-accent">dotfiles v1.0.0 — macOS development environment</div>
          <div class="terminal-muted mt-3">bootstrap · defaults · stow · theme</div>
        </div>
      </TerminalCard>
      <div class="mt-4">
        <ThemeDock />
      </div>
    </div>
  </div>
</section>
