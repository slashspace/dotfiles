---
import { stats } from "../data/site";
---

<section class="site-container" aria-label="Project highlights">
  <div class="grid gap-3 rounded-[2rem] border border-white/10 bg-white/[0.035] p-3 backdrop-blur sm:grid-cols-2 lg:grid-cols-4">
    {
      stats.map((stat) => (
        <div class="rounded-3xl border border-white/10 bg-cozy-surface/60 p-5 text-center">
          <div class="font-mono text-3xl font-black text-cozy-strong">{stat.value}</div>
          <div class="mt-1 text-sm font-semibold text-cozy-muted">{stat.label}</div>
        </div>
      ))
    }
  </div>
</section>
