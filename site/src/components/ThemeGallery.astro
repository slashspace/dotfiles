---
import { themes } from "../data/site";
---

<section id="themes" class="site-container section-shell">
  <div class="flex flex-col justify-between gap-4 lg:flex-row lg:items-end">
    <div class="max-w-3xl">
      <p class="font-mono text-sm font-bold text-cozy-pink">themes</p>
      <h2 class="mt-3 text-4xl font-black tracking-[-0.04em] text-cozy-strong sm:text-5xl">
        One palette, many tools
      </h2>
      <p class="mt-4 leading-8 text-cozy-muted">
        Nine palettes give the setup distinct moods, from soft pastel to warm retro,
        neon terminal, icy minimal, and classic editor themes.
      </p>
    </div>
  </div>
  <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
    {
      themes.map((theme) => (
        <article
          tabindex="0"
          class="group rounded-[2rem] border border-white/10 bg-cozy-surface/65 p-4 shadow-glow transition hover:-translate-y-1 hover:border-cozy-pink/50 focus-visible:-translate-y-1 focus-visible:border-cozy-pink/70"
        >
          <div class="overflow-hidden rounded-3xl border border-white/10" style={`background:${theme.bg};color:${theme.fg}`}>
            <div class="flex h-9 items-center gap-2 border-b border-white/10 bg-white/[0.06] px-3">
              <span class="h-2.5 w-2.5 rounded-full bg-cozy-pink" aria-hidden="true"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-cozy-yellow" aria-hidden="true"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-cozy-green" aria-hidden="true"></span>
              <span class="ml-auto font-mono text-[10px] opacity-70">{theme.slug}</span>
            </div>
            <div class="p-4 font-mono text-xs leading-6">
              <div>❯ dotfiles theme</div>
              <div>● {theme.name}</div>
              <div class="opacity-75">palette rendered</div>
            </div>
          </div>
          <div class="mt-4 flex items-start justify-between gap-3">
            <div>
              <h3 class="font-black text-cozy-strong">{theme.name}</h3>
              <p class="mt-1 font-mono text-xs text-cozy-muted">{theme.label}</p>
            </div>
          </div>
          <div class="mt-4 flex gap-2">
            {
              theme.swatches.map((swatch) => (
                <span class="h-5 flex-1 rounded-full border border-white/10" style={`background:${swatch}`} aria-hidden="true" />
              ))
            }
          </div>
        </article>
      ))
    }
  </div>
</section>
