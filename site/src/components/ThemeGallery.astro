---
import TerminalCard from "./TerminalCard.astro";
import { defaultTheme } from "../data/themeControls";

const renderTargets = ["Ghostty", "tmux", "Neovim", "SketchyBar", "Starship", "Borders", "Gitmux"];
---

<section id="themes" class="site-container section-shell">
  <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
    <div>
      <p class="font-mono text-sm font-bold text-cozy-pink">themes</p>
      <h2 class="mt-3 text-4xl font-black tracking-[-0.04em] text-cozy-strong sm:text-5xl">
        One palette, everywhere
      </h2>
      <p class="mt-4 leading-8 text-cozy-muted">
        The theme dock lives above the fold. This section explains what happens
        after a palette is selected: semantic colors flow into renderers and every
        tool receives a matching config.
      </p>

      <div class="mt-7 rounded-[2rem] border border-white/10 bg-cozy-surface/70 p-5 shadow-glow backdrop-blur-xl">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <p class="font-mono text-xs font-black uppercase tracking-[0.2em] text-cozy-muted">active palette</p>
            <h3 class="mt-2 text-2xl font-black text-cozy-strong" data-active-theme-name>{defaultTheme.name}</h3>
            <p class="mt-1 font-mono text-sm text-cozy-muted" data-active-theme-label>{defaultTheme.label}</p>
          </div>
          <div class="theme-summary-swatches" aria-hidden="true">
            <span style="background: var(--terminal-primary)"></span>
            <span style="background: var(--terminal-secondary)"></span>
            <span style="background: var(--terminal-tertiary)"></span>
            <span style="background: var(--terminal-accent)"></span>
          </div>
        </div>
      </div>
    </div>

    <TerminalCard title="theme pipeline" label="Theme renderer pipeline" bodyClass="theme-pipeline-body">
      <span class="terminal-accent">…/dotfiles</span> <span class="terminal-accent">main</span> [!]<br />
      <span class="terminal-accent">❯</span> dotfiles theme<br />
      <span class="terminal-muted">palette: <span data-active-theme-name>{defaultTheme.name}</span></span><br />
      <br />
      <span class="terminal-muted">render targets</span><br />
      <div class="mt-3 flex flex-wrap gap-2">
        {
          renderTargets.map((target) => (
            <span data-render-target class="terminal-panel rounded-full px-3 py-1 text-xs">
              {target}
            </span>
          ))
        }
      </div>
    </TerminalCard>
  </div>
</section>

<style>
  .theme-summary-swatches {
    display: grid;
    grid-template-columns: repeat(4, minmax(2.25rem, 1fr));
    gap: 0.45rem;
    min-width: min(14rem, 100%);
  }

  .theme-summary-swatches span {
    height: 2.4rem;
    border: 1px solid var(--border);
    border-radius: 999px;
  }

  :global(.theme-pipeline-body) {
    min-height: 17rem;
  }
</style>
