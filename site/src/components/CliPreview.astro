---
import TerminalCard from "./TerminalCard.astro";
import { cliCommands, cliHelp } from "../data/site";
---

<section class="site-container section-shell">
  <div class="grid gap-6 lg:grid-cols-2">
    <TerminalCard title="public commands" label="Dotfiles public CLI commands">
      {
        cliCommands.map((command) => (
          <div>
            <span class="text-cozy-pink">❯</span> <span>{command}</span>
          </div>
        ))
      }
    </TerminalCard>
    <TerminalCard title="dotfiles help" label="Dotfiles help output">
      <pre class="whitespace-pre-wrap text-xs leading-6 text-cozy-muted sm:text-sm">{cliHelp}</pre>
    </TerminalCard>
  </div>
</section>
