# Dotfiles dependency bundle.
# Run: brew bundle --file=~/dotfiles/system/packages/Brewfile

# Taps for formulae/casks not in homebrew-core
tap "FelixKratz/formulae"
tap "nikitabobko/tap"

# Core: required for stow and shell
brew "git"
brew "stow"
brew "fzf"

# Terminal / prompt
brew "gitmux" # tmux git status integration
brew "starship"
brew "eza"
brew "bat"
brew "zoxide"
brew "sheldon"

# Helpers
brew "jq"
brew "switchaudio-osx"

# MCP / Python tooling
brew "uv" # includes uvx for running Python MCP servers

# Optional desktop tools
brew "sketchybar"
brew "borders" # JankyBorders: window focus borders (FelixKratz/formulae)
cask "nikitabobko/tap/aerospace"

# GUI apps (cask)
cask "ghostty"
cask "karabiner-elements"

# Shell lint/format
brew "neovim"
brew "shellcheck"
brew "shfmt"

