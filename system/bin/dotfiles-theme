#!/usr/bin/env bash
# dotfiles theme — Pick a theme via fzf; current theme is marked ●.
set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"
THEMES_DIR="$DOTFILES_DIR/system/themes"
CURRENT_FILE="$THEMES_DIR/generated/.current-theme"

# shellcheck source=../lib/theme.sh
source "$DOTFILES_DIR/system/lib/theme.sh"

usage() {
  cat <<'EOF'
Usage:
  dotfiles theme [switch]   Pick a theme via fzf (current marked with ●)
EOF
}

_switch() {
  if ! command -v fzf &>/dev/null; then
    log_error "fzf is required for theme switching"
    exit 1
  fi

  local current
  current=$(current_theme_get)

  local picked
  picked=$(
    while IFS= read -r name; do
      if [[ "$name" == "$current" ]]; then
        printf '● %s\n' "$name"
      else
        printf '  %s\n' "$name"
      fi
    done < <(theme_list) | fzf --ansi --height=40% --reverse \
      --header="Select a theme  (● = current)" --prompt="Theme > " |
      sed -E 's/^[● ] *//'
  )
  [[ -n "$picked" ]] || {
    log_warn "No theme selected"
    exit 0
  }
  theme_apply "$picked"
}

case "${1:-switch}" in
  switch) _switch ;;
  help | --help | -h) usage ;;
  *)
    echo "Unknown theme command: $1" >&2
    usage
    exit 1
    ;;
esac
