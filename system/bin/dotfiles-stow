#!/usr/bin/env bash
# dotfiles stow — GNU Stow package manager
set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"

# shellcheck source=../../system/lib/log.sh
source "$DOTFILES_DIR/system/lib/log.sh"

# Registry: "source_root:name:target"
CORE=(
  "core:git:$HOME"
  "core:zsh:$HOME"
  "core:sheldon:$HOME/.config/sheldon"
  "core:tmux:$HOME/.config/tmux"
  "core:nvim:$HOME/.config/nvim"
  "core:starship:$HOME/.config/starship"
  "core:opencode:$HOME/.config/opencode"
  "system:bin:$HOME/.local/bin"
)

MODULES=(
  "modules:aerospace:$HOME/.config/aerospace"
  "modules:ghostty:$HOME/.config/ghostty"
  "modules:karabiner:$HOME/.config/karabiner"
  "modules:sketchybar:$HOME/.config/sketchybar"
  "modules:borders:$HOME/.config/borders"
)

usage() {
  cat <<'EOF'
Usage:
  dotfiles stow apply   --core | --modules | --all
  dotfiles stow delete  --core | --modules | --all
  dotfiles stow dry-run --core | --modules | --all
EOF
}

_run() {
  local action="$1" flag="$2" scope="$3"
  local packages=() failed=0

  case "$scope" in
    --core) packages=("${CORE[@]}") ;;
    --modules) packages=("${MODULES[@]}") ;;
    --all) packages=("${CORE[@]}" "${MODULES[@]}") ;;
    *)
      usage
      exit 1
      ;;
  esac

  local stow_action="-S"
  [[ "$action" == "delete" ]] && stow_action="-D"
  local adopt=""
  [[ "$action" == "stow" ]] && adopt="--adopt"

  for entry in "${packages[@]}"; do
    local root="${entry%%:*}" rest="${entry#*:}"
    local name="${rest%%:*}" target="${rest#*:}"
    local stow_dir="$DOTFILES_DIR/$root"

    if [[ ! -d "$stow_dir/$name" ]]; then
      log_warn "Missing: $stow_dir/$name"
      continue
    fi

    mkdir -p "$target"
    log_step "$action $name -> $target"

    local output
    if ! output=$(stow --dir="$stow_dir" --target="$target" $stow_action $flag ${adopt:+$adopt} "$name" 2>&1); then
      log_error "Failed to $action $name: $output"
      failed=1
    fi
  done

  [[ $failed -eq 0 ]] || {
    log_error "One or more packages failed"
    return 1
  }
}

[[ $# -ge 2 ]] || {
  usage
  exit 1
}
ACTION="$1"
shift
SCOPE="${1:-}"

case "$ACTION" in
  apply) _run stow "" "$SCOPE" ;;
  delete) _run delete "" "$SCOPE" ;;
  dry-run) _run stow "-vn" "$SCOPE" ;;
  *)
    usage
    exit 1
    ;;
esac
