#!/usr/bin/env bash
# dotfiles lint — Run shellcheck and shfmt -d across all repo shell scripts.
set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
cd "$DOTFILES_DIR"

# shellcheck source=../lib/log.sh
source "$DOTFILES_DIR/system/lib/log.sh"

# Find tracked shell files (.sh + bin/dotfiles* entries) excluding generated/.
FILES=()
while IFS= read -r f; do FILES+=("$f"); done < <(
  {
    find core modules system -type f -name '*.sh' \
      -not -path 'system/themes/generated/*' \
      -not -path 'system/lib/modules/*'
    find system/bin -type f -perm -u+x
  } | sort -u
)

[[ ${#FILES[@]} -gt 0 ]] || {
  log_warn "No shell files found"
  exit 0
}

failed=0

if command -v shellcheck &>/dev/null; then
  log_step "Running shellcheck on ${#FILES[@]} files"
  shellcheck --severity=error --shell=bash -x "${FILES[@]}" || failed=1
else
  log_warn "shellcheck not installed (brew install shellcheck)"
fi

if command -v shfmt &>/dev/null; then
  log_step "Running shfmt -d (2-space indent)"
  shfmt -d -i 2 -ci "${FILES[@]}" || failed=1
else
  log_warn "shfmt not installed (brew install shfmt)"
fi

if [[ $failed -eq 0 ]]; then
  log_ok "Lint passed"
else
  log_error "Lint reported issues"
  exit 1
fi
