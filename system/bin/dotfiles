#!/usr/bin/env bash
# dotfiles — Unified CLI entry point
set -euo pipefail

BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
VERSION="1.0.0"

usage() {
  cat <<HELP
dotfiles v${VERSION} — macOS development environment

Usage:
  dotfiles <command> [args...]

Commands:
  bootstrap                   One-time setup (brew + stow + default theme)
  stow apply|delete|dry-run --core|--modules|--all
                              Manage symlinks
  theme                       Pick a theme via fzf (current marked ●)
  defaults                    Apply macOS system defaults
  lint                        Run shellcheck + shfmt on all scripts
  check                       Verify Brewfile + show outdated formulae

Examples:
  dotfiles bootstrap
  dotfiles theme
  dotfiles stow apply --all
  dotfiles lint
HELP
}

case "${1:-}" in
  theme|stow|bootstrap|defaults|lint|check)
    sub="$1"
    cmd="$BIN_DIR/dotfiles-$sub"
    if [[ -x "$cmd" ]]; then
      shift
      exec "$cmd" "$@"
    else
      printf "\033[31m✗\033[0m  Subcommand not found: %s\n" "$sub" >&2
      exit 1
    fi
    ;;
  help|--help|-h|"")
    usage
    ;;
  *)
    echo "Unknown command: $1" >&2
    echo "Run 'dotfiles help' for usage." >&2
    exit 1
    ;;
esac
