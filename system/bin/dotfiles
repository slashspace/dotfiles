#!/usr/bin/env bash
# dotfiles — Unified CLI entry point.
# Subcommands are auto-discovered: any executable file named `dotfiles-<name>`
# in this directory is reachable as `dotfiles <name>`.
set -euo pipefail

BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
VERSION="1.0.0"

list_subcommands() {
  local f
  for f in "$BIN_DIR"/dotfiles-*; do
    [[ -x "$f" ]] || continue
    basename "$f" | sed 's/^dotfiles-//'
  done | sort
}

usage() {
  printf 'dotfiles v%s — macOS development environment\n\n' "$VERSION"
  echo "Usage: dotfiles <command> [args...]"
  echo ""
  echo "Commands:"
  local sub
  for sub in $(list_subcommands); do
    printf '  %s\n' "$sub"
  done
  echo ""
  echo "Run 'dotfiles <command> --help' for command-specific help."
}

case "${1:-}" in
  ""|help|--help|-h)
    usage
    ;;
  *)
    cmd="$BIN_DIR/dotfiles-$1"
    if [[ -x "$cmd" ]]; then
      shift
      exec "$cmd" "$@"
    fi
    echo "Unknown command: $1" >&2
    echo "Run 'dotfiles help' for usage." >&2
    exit 1
    ;;
esac
