---
import { themes } from "../data/site";
import { defaultTheme, defaultThemeSlug, getSiteColors } from "../data/themeControls";
---

<div class="theme-dock" aria-label="Try a theme">
  <div class="theme-dock-header">
    <div>
      <p class="font-mono text-[0.68rem] font-black uppercase tracking-[0.22em] text-cozy-pink">try a theme</p>
      <p class="mt-1 text-sm font-semibold text-cozy-muted">Changes the whole page instantly.</p>
    </div>
    <span class="theme-dock-current" data-active-theme-name>{defaultTheme.name}</span>
  </div>

  <div class="theme-dock-chips" aria-label="Theme controls">
    {
      themes.map((theme) => {
        const colors = getSiteColors(theme);

        return (
          <button
            type="button"
            class="theme-chip"
            data-theme-chip
            data-name={theme.name}
            data-label={theme.label}
            data-bg={colors.bg}
            data-bg-alt={colors.bgAlt}
            data-surface={colors.surface}
            data-surface-raised={colors.surfaceRaised}
            data-border={colors.border}
            data-text={colors.text}
            data-text-strong={colors.textStrong}
            data-text-muted={colors.textMuted}
            data-pink={colors.pink}
            data-mauve={colors.mauve}
            data-blue={colors.blue}
            data-teal={colors.teal}
            data-green={colors.green}
            data-yellow={colors.yellow}
            data-glow-shadow={colors.glowShadow}
            data-terminal-bg={colors.terminalBg}
            data-terminal-fg={colors.terminalFg}
            data-terminal-primary={colors.terminalPrimary}
            data-terminal-secondary={colors.terminalSecondary}
            data-terminal-tertiary={colors.terminalTertiary}
            data-terminal-accent={colors.terminalAccent}
            aria-pressed={theme.slug === defaultThemeSlug ? "true" : "false"}
          >
            <span class="theme-chip-swatches" aria-hidden="true">
              {theme.swatches.slice(0, 3).map((swatch) => <span style={`background:${swatch}`} />)}
            </span>
            <span>{theme.name}</span>
          </button>
        );
      })
    }
  </div>
</div>

<script>
  const root = document.documentElement;
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-theme-chip]"));
  const variableMap = {
    bg: "--bg",
    bgAlt: "--bg-alt",
    surface: "--surface",
    surfaceRaised: "--surface-raised",
    border: "--border",
    text: "--text",
    textStrong: "--text-strong",
    textMuted: "--text-muted",
    pink: "--pink",
    mauve: "--mauve",
    blue: "--blue",
    teal: "--teal",
    green: "--green",
    yellow: "--yellow",
    glowShadow: "--glow-shadow",
    terminalBg: "--terminal-bg",
    terminalFg: "--terminal-fg",
    terminalPrimary: "--terminal-primary",
    terminalSecondary: "--terminal-secondary",
    terminalTertiary: "--terminal-tertiary",
    terminalAccent: "--terminal-accent",
  };

  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      chips.forEach((item) => item.setAttribute("aria-pressed", "false"));
      chip.setAttribute("aria-pressed", "true");

      Object.entries(variableMap).forEach(([dataKey, variableName]) => {
        const value = chip.dataset[dataKey];

        if (value) {
          root.style.setProperty(variableName, value);
        }
      });

      document.querySelectorAll("[data-active-theme-name]").forEach((element) => {
        element.textContent = chip.dataset.name ?? "";
      });
      document.querySelectorAll("[data-active-theme-label]").forEach((element) => {
        element.textContent = chip.dataset.label ?? "";
      });
    });
  });
</script>

<style>
  .theme-dock {
    border: 1px solid var(--border);
    border-radius: 2.5rem;
    background: color-mix(in srgb, var(--surface) 65%, transparent);
    padding: 1rem;
    box-shadow: var(--glow-shadow);
    backdrop-filter: blur(18px);
  }

  .theme-dock-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.9rem;
  }

  .theme-dock-current {
    border: 1px solid color-mix(in srgb, var(--yellow) 45%, transparent);
    border-radius: 999px;
    color: var(--text-strong);
    background: color-mix(in srgb, var(--yellow) 12%, transparent);
    padding: 0.35rem 0.65rem;
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.72rem;
    font-weight: 900;
    white-space: nowrap;
  }

  .theme-dock-chips {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding-top: 0.15rem;
    padding-bottom: 0.2rem;
    scrollbar-width: thin;
    position: relative;
    z-index: 10;
  }

  .theme-chip {
    display: inline-flex;
    min-height: 2.35rem;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface-raised) 72%, transparent);
    padding: 0.45rem 0.7rem;
    color: var(--text);
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.7rem;
    font-weight: 800;
    transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease, background 160ms ease, color 160ms ease;
  }

  .theme-chip:hover,
  .theme-chip[aria-pressed="true"] {
    border-color: color-mix(in srgb, var(--pink) 72%, transparent);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--pink) 14%, transparent);
    color: var(--text-strong);
    position: relative;
    z-index: 20;
  }

  .theme-chip:hover {
    transform: translateY(-1px);
  }

  .theme-chip-swatches {
    display: flex;
    gap: 0.18rem;
  }

  .theme-chip-swatches span {
    height: 0.56rem;
    width: 0.56rem;
    border-radius: 999px;
  }
</style>
