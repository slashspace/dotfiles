---
import { githubUrl } from "../data/site";
---

<footer class="site-container pb-10">
  <div class="rounded-[2rem] border border-white/10 bg-white/[0.03] p-6 text-center text-sm text-cozy-muted">
    <p class="font-semibold text-cozy-strong">Built for cozy macOS terminal workflows.</p>
    <p class="mt-2">GNU Stow · Ghostty · Neovim · tmux · SketchyBar</p>
    <p class="mt-4">
      <a class="font-bold text-cozy-pink hover:text-cozy-strong" href={githubUrl}>GitHub</a>
      <span aria-hidden="true"> · </span>
      <span>MIT License</span>
    </p>
  </div>
</footer>
