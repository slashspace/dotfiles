---
import { features } from "../data/site";
---

<section id="workflow" class="site-container section-shell">
  <div class="max-w-3xl">
    <p class="font-mono text-sm font-bold text-cozy-pink">workflow</p>
    <h2 class="mt-3 text-4xl font-black tracking-[-0.04em] text-cozy-strong sm:text-5xl">
      Everything stays cute, but the structure stays serious
    </h2>
  </div>
  <div class="mt-10 grid gap-5 md:grid-cols-2">
    {
      features.map((feature, index) => (
        <article class="glass-card rounded-[2rem] p-6 transition hover:-translate-y-1 hover:border-cozy-pink/45">
          <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-br from-cozy-pink/25 to-cozy-blue/20 font-mono text-sm font-black text-cozy-pink">
            {String(index + 1).padStart(2, "0")}
          </div>
          <h3 class="text-xl font-black text-cozy-strong">{feature.title}</h3>
          <p class="mt-3 leading-7 text-cozy-muted">{feature.description}</p>
        </article>
      ))
    }
  </div>
</section>
