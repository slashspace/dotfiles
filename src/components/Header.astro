---
import { githubUrl, navItems } from "../data/site";
---

<header class="site-container sticky top-4 z-50">
  <nav
    class="mx-auto flex max-w-5xl items-center justify-between gap-3 rounded-full border border-white/10 bg-cozy-surface/75 px-3 py-2 shadow-glow backdrop-blur-xl"
    aria-label="Primary navigation"
  >
    <a href="#top" class="rounded-full px-3 py-2 text-sm font-black tracking-tight text-cozy-pink">
      <span aria-hidden="true">♡</span> dotfiles
    </a>
    <div class="hidden items-center gap-1 sm:flex">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="rounded-full px-3 py-2 text-sm font-semibold text-cozy-muted transition hover:bg-white/8 hover:text-cozy-strong"
          >
            {item.label}
          </a>
        ))
      }
    </div>
    <div class="flex items-center gap-2">
      <a
        href="#install"
        class="rounded-full bg-white/8 px-3 py-2 text-sm font-bold text-cozy-text ring-1 ring-white/10 transition hover:bg-white/12 hover:text-cozy-strong"
      >
        Install
      </a>
      <a
        href={githubUrl}
        class="rounded-full bg-gradient-to-r from-cozy-pink to-cozy-mauve px-3 py-2 text-sm font-black text-cozy-bg transition hover:scale-[1.02]"
      >
        GitHub
      </a>
    </div>
  </nav>
</header>
