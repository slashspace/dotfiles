#!/usr/bin/env bash
# Filename: ~/dotfiles/modules/sketchybar/sketchybarrc

# ── Theme colors (generated by `dotfiles theme`) ──────────────────────────
THEME_COLORS="${DOTFILES_DIR:-$HOME/dotfiles}/system/themes/generated/sketchybar-colors.sh"
[[ -f "$THEME_COLORS" ]] && source "$THEME_COLORS"

source "$CONFIG_DIR/icons.sh"

ITEM_DIR="$CONFIG_DIR/items"
PLUGIN_DIR="$CONFIG_DIR/plugins"

FONT="JetBrainsMono Nerd Font"
PADDINGS=1

# ── Bar appearance ────────────────────────────────────────────────────────
bar=(
  height=45
  color=$BAR_COLOR
  border_width=2
  border_color=$BAR_BORDER_COLOR
  shadow=off
  position=top
  sticky=on
  padding_right=10
  padding_left=10
  y_offset=-5
  margin=-2
  topmost=window
)
sketchybar --bar "${bar[@]}"

# ── Item defaults ─────────────────────────────────────────────────────────
defaults=(
  updates=when_shown
  icon.font="$FONT:Bold:14.0"
  icon.color=$ICON_COLOR
  icon.padding_left=$PADDINGS
  icon.padding_right=$PADDINGS
  label.font="$FONT:Semibold:13.0"
  label.color=$LABEL_COLOR
  label.padding_left=$PADDINGS
  label.padding_right=$PADDINGS
  padding_right=$PADDINGS
  padding_left=$PADDINGS
  background.height=26
  background.corner_radius=9
  background.border_width=2
  popup.background.border_width=2
  popup.background.corner_radius=9
  popup.background.border_color=$POPUP_BORDER_COLOR
  popup.background.color=$POPUP_BACKGROUND_COLOR
  popup.blur_radius=20
  popup.background.shadow.drawing=on
  scroll_texts=on
)
sketchybar --default "${defaults[@]}"

# ── Items (explicit order so right-side placement stays stable) ───────────
for item in \
  "$ITEM_DIR/spaces.sh" \
  "$ITEM_DIR/calendar.sh" \
  "$ITEM_DIR/battery.sh" \
  "$ITEM_DIR/volume.sh" \
  "$ITEM_DIR/wifi.sh"
do
  [[ -f "$item" ]] && source "$item"
done

sketchybar --hotload on
sketchybar --update
sketchybar --trigger aerospace_workspace_change

echo "sketchybar configuration loaded."
