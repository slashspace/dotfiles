#!/usr/bin/env bash
# scripts/check — Verify Brewfile dependencies and report outdated formulae.
set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
BREWFILE="$DOTFILES_DIR/system/packages/Brewfile"

# shellcheck source=../lib/log.sh
source "$DOTFILES_DIR/system/lib/log.sh"

if ! command -v brew &>/dev/null; then
  log_error "Homebrew is not installed"
  exit 1
fi

log_step "Checking Brewfile satisfaction"
if brew bundle check --file="$BREWFILE" --verbose; then
  log_ok "All Brewfile dependencies installed"
else
  log_warn "Run: brew bundle --file=$BREWFILE"
fi

log_step "Outdated formulae"
brew outdated --quiet || true
